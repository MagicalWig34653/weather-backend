{
	"name": "showers-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:mock": "vite dev --mode mock",
		"test": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.0",
		"@lucide/svelte": "1.67.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.4",
		"bits-ui": "2.20.0",
		"clsx": "2.1.1",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"jsdom": "30.1.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.6.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.0",
		"tailwindcss": "4.3.4",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.0",
		"vitest": "5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Betreiber-Dashboard (statischer SvelteKit-Build, vom Backend unter /dash ausgeliefert)",
	"engines": {
		"node": ">=22"
	}
}
