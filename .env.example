# Copy to .env (gitignored, mode 600). deploy/swarm/setup.sh writes the production .env for you;
# the same file is read by deploy/swarm/update.sh. Placeholders only - never commit real values or secrets.
# Edit it by menu or command line with deploy/swarm/settings.sh (whiptail; --list, --set KEY=VALUE, --check). Its tables
# deploy/swarm/config-registry.tsv and config-extra.tsv must contain every variable of this file and of stack.yaml (CI checks it).

# ---- Production (Docker Swarm; written by deploy/swarm/setup.sh) -------------
# The image is fixed in deploy/swarm/stack.yaml: ghcr.io/magicalwig34653/weather-backend-radar
RADAR_STACK=radar
# edge = newest main build; update.sh pins the newest sha-<commit> tag here.
RADAR_IMAGE_TAG=edge
RADAR_REPLICAS=2
# Published ingress port for the external TLS reverse proxy.
RADAR_PORT=38090
RADAR_CPU_LIMIT=0
RADAR_MEMORY_LIMIT=0
# Optional public base URL (reverse proxy) for the readiness check after a rollout.
PUBLIC_BASE_URL=
# External MariaDB 12.3. The user needs SELECT/INSERT/UPDATE/DELETE and, for the migration job, CREATE on the schema.
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=showernow
DB_USER=showernow
DB_POOL_SIZE=4
# The password is a Swarm secret, never an env value:  docker secret create showernow_db_password <file>
DB_PASSWORD_SECRET=showernow_db_password
# Tuning (defaults are fine)
#CACHE_MAX_MB=64
#RETENTION_RUNS=16
# Past analysis images kept and served via /v1/radar/history.json (1-72, default 48).
#HISTORY_HOURS=48
#FETCH_WORKERS=3
# Radar image width (256-2048; push needs 1024) and ingest timing (seconds).
#IMAGE_WIDTH=1024
#AVAILABILITY_DELAY_SECONDS=200
#JITTER_SECONDS=20
#REQUEST_TIMEOUT_SECONDS=30
# Additional map layers (comma separated, default radar only = nothing new starts): pressure, pressure_eu, lightning,
# clouds, cloudmask, cloudmask_vis, cloudmask_vis_eu (the *_eu layers cover Europe at 2048 px; cloudmask_vis* = visible channel, daytime).
# Example: LAYERS=radar,pressure,pressure_eu,lightning,clouds,cloudmask,cloudmask_vis,cloudmask_vis_eu
# Needs migration 004 (run update.sh once before enabling). Each enabled layer adds a few requests per minute to DWD/EUMETSAT.
#LAYERS=radar
# Symptom "layer routes answer 404": check LAYERS here on the server, redeploy with update.sh --force, see GET /v1/status and docs-site Betrieb.
#PRESSURE_FORECAST_HOURS=48
#PRESSURE_RETENTION_RUNS=2
# Forecast hours of the Europe pressure layer (1-168; images are 4.3x larger, so fewer hours by default).
#PRESSURE_EU_FORECAST_HOURS=24
#LIGHTNING_HISTORY_HOURS=3
#CLOUDS_HISTORY_HOURS=3
#CLOUDMASK_HISTORY_HOURS=3
#CLOUDMASK_VIS_HISTORY_HOURS=3
#CLOUDMASK_VIS_EU_HISTORY_HOURS=3
#LAYER_PAUSE_SECONDS=2
# Temperature and humidity maps: LAYERS needs `temperature` (restart), TEMP_SOURCE (live) chooses the source: off (default, routes answer 404),
# wms (temperature only, ca. 200 DWD requests/day), icon_d2 (adds dew point; needs the ICON-D2 ingest of a later release).
#TEMP_SOURCE=off
# ICON-D2 variables with load: td_2m (dew point, default), relhum_2m (relative humidity, optional); t_2m is always included.
#TEMP_D2_PARAMS=td_2m
#TEMP_FALLBACK_WARM=true
#TEMP_D2_MAX_AGE_HOURS=7
#TEMP_WMS_LAYER=dwd:Icon-eu_reg00625_fd_gl_T
# ICON-D2 run interval in hours: 6 (default) or 3.
#TEMP_D2_RUN_INTERVAL_HOURS=6
# Identify the operator to the DWD in the User-Agent (e.g. a contact URL); no personal data of app users.
# Only for tests: other WMS endpoint (default: the DWD GeoServer).
#WMS_URL=https://maps.dwd.de/geoserver/ows
#EUMETSAT_WMS_URL=https://view.eumetsat.int/geoserver/wms
#USER_AGENT=ShowerNow-radar-ingest/1.0 (+https://example.org/contact)

# ---- Public pages /datenschutz, /marketing, /support (all optional, but /datenschutz needs the first three) ----
# .env is sourced by the shell: put values with spaces in double quotes; no $, backticks or double quotes inside.
# A literal \n in OPERATOR_ADDRESS becomes a line break. Placeholders only - enter the real values on the server.
#OPERATOR_NAME="Vorname Nachname"
#OPERATOR_ADDRESS="Musterstrasse 1\n12345 Musterstadt"
#OPERATOR_EMAIL=kontakt@example.org
# Sentence about the reverse proxy's access logs (whether and how long it logs); decided by the operator.
#PROXY_LOG_NOTE="Der Reverse Proxy speichert keine Zugriffsprotokolle."
# Optional https links shown on /marketing.
#APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
#TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX

# ---- Optional server push (rain-start notifications; OFF by default, the radar cache works without it) ----
# Only takes effect with PUSH_ENABLED=true; then all four APNS_* values are required and IMAGE_WIDTH must stay 1024.
# The .p8 key is a Swarm secret (never an env value, never committed): docker secret create showernow_apns_key AuthKey_XXXXXXXXXX.p8
# stack.yaml passes the values below through; the secret is mounted by deploy/swarm/stack.push.yaml, which swarm-deploy.sh adds only
# when PUSH_ENABLED=true (update.sh then checks that the secret exists before rolling out).
# By hand ALWAYS with both files (stack.yaml alone has no APNs secret and the service cannot start with push on):
#   cd deploy/swarm; set -a; . ../../.env; set +a; docker stack deploy --resolve-image never -c stack.yaml -c stack.push.yaml radar
#PUSH_ENABLED=false
#APNS_KEY_SECRET=showernow_apns_key
#APNS_KEY_ID=XXXXXXXXXX
#APNS_TEAM_ID=XXXXXXXXXX
#APNS_TOPIC=com.example.app
# sandbox | production | both  (which APNs hosts may be used; must match the app builds that register)
#APNS_ENV=production
# Server-wide caps (new installations beyond them get 503 server_full; existing ones keep working). Defaults shown.
#PUSH_MAX_INSTALLATIONS=100000
#PUSH_MAX_SUBSCRIPTIONS=400000
#PUSH_MAX_REGION_CELLS=50000000
# Cap of subscriptions with live_activity=true (503 activity_full beyond it).
#PUSH_MAX_ACTIVITY_SUBSCRIPTIONS=5000
# Per installation and rate limits (defaults shown; ranges see docs-site installation).
#PUSH_MAX_REGIONS_PER_INSTALLATION=3
#PUSH_MAX_CELLS_PER_INSTALLATION=8000
#PUSH_RATE_PER_INSTALLATION=60
#PUSH_RATE_GLOBAL_REGISTRATIONS=600
#PUSH_RATE_GLOBAL_REQUESTS=3000
#PUSH_RATE_FAILED_AUTH=10
#PUSH_TEST_LIMIT_PER_HOUR=3

# ---- Optional operator dashboard (OFF by default; separate listener, reachable only through your reverse proxy) ----
# Runs as its own service and publishes one ingress port (DASH_PUBLISH_PORT) for your EXTERNAL reverse proxy (TLS, Host header
# passed through unchanged). Firewall that port to the proxy only and register the passkey right after the first start,
# see docs-site installation ("Dashboard aktivieren"). deploy/swarm/stack.dashboard.yaml is added by swarm-deploy.sh/update.sh when DASH_ENABLED=true.
#DASH_ENABLED=false
# Required with DASH_ENABLED=true: https origin without path under which the dashboard is opened (WebAuthn needs HTTPS).
#DASH_ORIGIN=https://dashboard.example.org
# Optional WebAuthn relying party id (default: host of DASH_ORIGIN).
#DASH_RP_ID=
#DASH_PORT=9090
# Published ingress port on the swarm nodes that the reverse proxy forwards to (container port stays DASH_PORT).
#DASH_PUBLISH_PORT=39090
# First-passkey window after start, session length, idle logout. Defaults shown.
#DASH_SETUP_WINDOW_MINUTES=15
#DASH_SESSION_HOURS=12
#DASH_IDLE_MINUTES=30
# Proxy token (REQUIRED with DASH_ENABLED=true): the external reverse proxy must send it as header X-Dashboard-Proxy-Token (set it, do not
# append); without it the dashboard port answers 404. The token is a Swarm SECRET, never a value in this file (no DASH_PROXY_TOKEN here):
#   umask 077; openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' > proxy-token.txt
#   docker secret create showernow_dashboard_proxy_token proxy-token.txt     # then put the value into the proxy and `rm proxy-token.txt`
# Only the NAME of the secret is configurable. Rotation: create a new secret, set DASH_PROXY_TOKEN_SECRET=<new> and
# DASH_PROXY_TOKEN_PREVIOUS_SECRET=<old>, deploy, switch the proxy header to the new value, then remove DASH_PROXY_TOKEN_PREVIOUS_SECRET.
# DASH_PROXY_TOKEN_REQUIRED=false has no effect in the Swarm stack (the secret is always mounted and enforced).
#DASH_PROXY_TOKEN_SECRET=showernow_dashboard_proxy_token
#DASH_PROXY_TOKEN_PREVIOUS_SECRET=
# Pause between replica restarts of the controlled restart (15 to 300).
#RESTART_STAGGER_SECONDS=45
# k suppression: groups smaller than this appear as "<k" (3 to 50).
#DASH_MIN_GROUP=5
# Warning thresholds (yellow/red) can be changed live in the dashboard; env values pin them. Names: DASH_WARN_<NAME>_YELLOW|_RED with
# LAYER_AGE_FACTOR, ERROR_RATE_5XX, OUTBOX_AGE_SECONDS, APNS_REJECTION, TOKEN_INVALIDATION, CACHE_HIT, CAP_FILL, LA_START_RATIO. Defaults: see config-registry.tsv.
#DASH_WARN_ERROR_RATE_5XX_YELLOW=0.005
#DASH_WARN_ERROR_RATE_5XX_RED=0.02

# ---- Optional device pairing (OFF by default; needs PUSH_ENABLED=true and DASH_ENABLED=true) ----
# Pairing happens only in a pairing window that the operator opens in the dashboard ("Kopplung per Fenster"): a device can fetch a
# link code only while the window is open (auto-closes after the first successful pairing). Nothing secret here.
#DEVICE_LINK_ENABLED=false
# Length of a pairing window in minutes when opened in the dashboard (1 to 15).
#DEVICE_LINK_WINDOW_MINUTES=5
# Additionally demand Apple's signed app transaction (TestFlight proof, old contract). Default false: the open window is the gate.
# Only with true the following three values matter; Production receipts are never accepted.
#DEVICE_LINK_REQUIRE_TESTFLIGHT=false
# Empty = base of APNS_TOPIC.
#DEVICE_LINK_BUNDLE_ID=
# Accepted receiptType values (Sandbox, Xcode, LocalTesting); Production is refused by design.
#DEVICE_LINK_ALLOWED_ENVS=Sandbox
#DEVICE_LINK_MAX_AGE_HOURS=24
# Paired devices at most (1 to 5), expiry of a pairing in days (0 = until revoked), "last seen" shown as stale after N days.
#DASH_MAX_DEVICES=3
#DASH_DEVICE_TTL_DAYS=0
#DASH_DEVICE_STALE_DAYS=14

# ---- Local development (compose.yaml; dev-only placeholders) -----------------
DEV_DB_ROOT_PASSWORD=dev-root-only
DEV_DB_PASSWORD=dev-only
DEV_DB_HOST_PORT=23306
DEV_RADAR_HOST_PORT=28090
