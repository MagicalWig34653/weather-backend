# Example environment for deploy/swarm/stack.yaml. Placeholders only - never commit real values.
# setup.sh copies this to deploy/swarm/stack.env (mode 600, gitignored) and creates the Swarm secret.

# --- Image (published by .github/workflows/docker-publish.yml) -----------------
# Lower-case ghcr.io/<github-owner>/<repository>-radar; tags: sha-<commit>, latest, <version>. Prefer a pinned sha- tag.
RADAR_IMAGE=ghcr.io/OWNER/weather-backend-radar
RADAR_IMAGE_TAG=latest
RADAR_REPLICAS=2
# Published ingress port for the external TLS reverse proxy.
RADAR_PORT=38090
#RADAR_CPU_LIMIT=0.5
#RADAR_MEMORY_LIMIT=256M

# --- External MariaDB (stable 12.3) -----------------------------------------
# The user needs DML plus CREATE on this schema (the service applies the versioned migrations at start).
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=showernow
DB_USER=showernow
# The password is a Swarm secret, never an env value:  printf '%s' "$PW" | docker secret create showernow_db_password -
#DB_PASSWORD_SECRET=showernow_db_password
DB_POOL_SIZE=4

# --- Tuning (defaults are fine) ------------------------------------------------
# In-process LRU per replica (current runs need about 2-10 MB). The proxy does not cache, this cache does.
#CACHE_MAX_MB=64
#RETENTION_RUNS=16
#FETCH_WORKERS=3
# Identify the operator to the DWD in the User-Agent (e.g. a contact URL); no personal data of app users.
#USER_AGENT=ShowerNow-radar-ingest/1.0 (+https://example.org/contact)
